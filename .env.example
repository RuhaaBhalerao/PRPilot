# ==========================================
# PRPilot Backend Environment Variables
# Copy this file to apps/api/.env for local backend development
# ==========================================

# Port for the Express API server
PORT=3001

# Allowed origin for CORS (frontend URL)
WEB_ORIGIN=http://localhost:5173

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Optional GitHub Personal Access Token (classic or fine-grained)
# Increases rate limits from 60 req/hr to 5,000 req/hr for public repositories.
# If left blank or unset, PRPilot safely uses unauthenticated requests.
#
# How to configure locally:
# 1. Generate a token at https://github.com/settings/tokens (no special scopes needed for public repos).
# 2. Add GITHUB_TOKEN=ghp_yourTokenHere in apps/api/.env (or root .env).
# 3. NEVER commit real tokens to git or expose them to frontend code.
GITHUB_TOKEN=

# AI LLM Provider Configuration (Server-side only)
# Supports OpenRouter (sk-or-v1-...) or OpenAI-compatible providers
# NEVER commit real API keys into source control or expose them to frontend code.
OPEN_AI_API_KEY=
OPEN_AI_MODEL=gpt-6.1-sol
# Optional custom endpoint (auto-detected: openrouter.ai for sk-or-v1 keys, openai.com for sk- keys)
# OPEN_AI_BASE_URL=https://openrouter.ai/api/v1

# PostgreSQL / Neon Database Connection String (Server-side only)
# Used for persistent analysis history. Never commit credentials to source control.
DATABASE_URL=


# ==========================================
# PRPilot Frontend Environment Variables
# Copy to apps/web/.env for local frontend development
# ==========================================

# Base URL for PRPilot Express API
VITE_API_BASE_URL=http://localhost:3001
